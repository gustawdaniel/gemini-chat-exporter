{
  "manifest_version": 3,
  "name": "Gemini Chat Exporter",
  "version": "1.3.0",
  "description": "Export Gemini chat history to Markdown, Plain Text, or JSON format, with full bulk ZIP export and chat browser support",
  "permissions": [
    "activeTab",
    "downloads",
    "storage",
    "tabs",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://gemini.google.com/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "gemini-chat-exporter@brain-os.local",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "js": [
        "jszip.min.js",
        "utils.js",
        "gemini_rpc_fetcher.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "browse.html",
        "browse.js",
        "db.js",
        "utils.js",
        "gemini_rpc_fetcher.js",
        "jszip.min.js"
      ],
      "matches": [
        "https://gemini.google.com/*"
      ]
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}